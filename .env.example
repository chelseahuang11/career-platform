# Copy to .env (never commit .env). Run commands with: uv run --env-file .env ...
# Paths are relative to the directory uvicorn starts in (the repo root).
CAREER_PLATFORM_DATA_DIR=data
CAREER_PLATFORM_FALLBACK=data/profile_fallback.json

# The app reads DATABASE_URL. On Railway it is set in the web service's Variables
# (it points at the Postgres service). On the laptop, point it at the local
# Docker database (see README, "Run it on my laptop").
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5434/career_platform_dev

# Tests drop and recreate tables, so they only run against a database whose name ends in _test.
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5434/career_platform_test

# Optional, for reading the live data from the laptop. Railway: Postgres service ->
# Variables -> DATABASE_PUBLIC_URL. No trailing slash.
RAILWAY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
